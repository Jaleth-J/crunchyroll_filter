{
  "manifest_version": 2,
  "name": "Crunchyroll Language Filter",
  "version": "2.1",
  "description": "Filtert Crunchyroll-Serien nach Audiosprache - Persistent Storage Ansatz",
  "icons": {
    "48": "icons/icon48.png"
  },
  "permissions": [
    "storage",
    "https://www.crunchyroll.com/*",
    "http://www.crunchyroll.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/de/series/*"],
      "js": ["series-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": ["*://*.crunchyroll.com/de/series/*"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crunchyroll-filter@jaleth.dev",
      "strict_min_version": "58.0"
    }
  }
}
