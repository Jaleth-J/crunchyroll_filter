{
  "manifest_version": 3,
  "name": "Crunchyroll Language Filter",
  "version": "2.0",
  "description": "Filtert Crunchyroll-Serien nach Audiosprache - Popular Page Support mit CORS-freiem Background-Script",
  "icons": {
    "48": "icons/icon48.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  }
}
